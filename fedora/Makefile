.PHONY: install post-install
install: install-fonts-nerd-font-bitstreamverasansmono install-fonts-nerd-font-cousine install-fonts-nerd-font-dejavusansmono install-fonts-nerd-font-hack install-fonts-nerd-font-meslo install-fonts-nerd-font-mononoki install-fonts-nerd-font-symbols install-fonts-nerd-font-robotomono install-fonts-nerd-font-sourcecodepro

post-install:
	@if [ -z "$(DESTDIR)" ]; then \
	  glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true; \
	  for d in /usr/share/icons/*/; do [ -f "$$d/index.theme" ] && gtk-update-icon-cache -q -f "$$d" || true; done; \
	  command -v fc-cache >/dev/null && fc-cache -s >/dev/null 2>&1 || true; \
	  update-desktop-database -q /usr/share/applications 2>/dev/null || true; \
	fi

