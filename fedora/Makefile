# Generated by porting/scripts/gen-fedora-packaging.py from debian/ (fonts-nerd-fonts). Do not edit by hand;
# fix the generator or porting/fedora/repos.json instead.
# Track B usage (from the repo root):  make -f fedora/Makefile && sudo make -f fedora/Makefile install
# RPM usage: the spec runs the same targets with DESTDIR=%{buildroot}.

DESTDIR ?=
PREFIX ?= /usr
LIBDIR ?= $(PREFIX)/lib64
SYSCONFDIR ?= /etc
BUILDDIR ?= _fedora_build
INSTALL ?= install
CP ?= cp -a --no-preserve=ownership
PYTHON ?= python3
MESON_FLAGS ?= --buildtype=release

# Don't leak our variables into upstream sub-makes: command-line vars travel via MAKEFLAGS (MAKEOVERRIDES)
# *and* the environment (unexport). Upstream Makefiles like xrescat use `PREFIX ?= $(DESTDIR)` (BRE-010).
MAKEOVERRIDES :=
unexport PREFIX LIBDIR SYSCONFDIR BUILDDIR INSTALL CP PYTHON MESON_FLAGS

.PHONY: all build install patch
all: build

build:

.PHONY: check
check:
	@echo 'no upstream tests'

.PHONY: install-fonts-nerd-font-bitstreamverasansmono
install-fonts-nerd-font-bitstreamverasansmono:
	$(INSTALL) -d "$(DESTDIR)/usr/share/fonts/truetype"
	$(CP) usr/share/fonts/truetype/bitstreamverasansmono "$(DESTDIR)/usr/share/fonts/truetype/"
	$(INSTALL) -d "$(DESTDIR)/usr/share/fontconfig/conf.avail"
	$(CP) usr/share/fontconfig/conf.avail/30-fonts-nerd-font-bitstreamverasansmono.conf "$(DESTDIR)/usr/share/fontconfig/conf.avail/"
	$(INSTALL) -d "$(DESTDIR)/etc/fonts/conf.d"
	ln -sfn /usr/share/fontconfig/conf.avail/30-fonts-nerd-font-bitstreamverasansmono.conf "$(DESTDIR)/etc/fonts/conf.d/30-fonts-nerd-font-bitstreamverasansmono.conf"
	@$(MAKE) -f fedora/Makefile post-install

